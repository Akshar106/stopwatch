# Copy to terraform.tfvars for local `make up ENV=prod` (CI sets TF_VAR_* instead).
# terraform.tfvars is not git-ignored by default and holds your email: don't commit it.

owner       = "your-name"
alert_email = "you@example.com"
ttl         = "none" # or a date, e.g. "2026-12-31"

# Ingest runs by default in prod. Pause it (e.g. during an upstream incident) with:
# ingest_enabled = false

# Feature flags (docs/06 §6)
# alerts_enabled      = false
# ask_enabled         = false
# demo_enabled        = true
# ask_monthly_cap_usd = 1.0

# If stopwatch-prod-{lake,site,artifacts} are taken in the global S3 namespace:
# bucket_suffix = "-a1b2"

# Optional custom domain (certificate must be in us-east-1):
# domain_aliases      = ["stopwatch.example"]
# acm_certificate_arn = "arn:aws:acm:us-east-1:<account>:certificate/<id>"
