# Copy to terraform.tfvars for local `make up ENV=staging` (CI sets TF_VAR_* instead).
# terraform.tfvars is not git-ignored by default and holds your email: don't commit it.

owner       = "your-name"
github_repo = "your-github-user/stopwatch"
alert_email = "you@example.com"
ttl         = "none" # or a date, e.g. "2026-12-31"

# Turn the per-minute ingest on only while testing the pipeline:
# ingest_enabled = true

# Feature flags (docs/06 §6)
# alerts_enabled      = true
# ask_enabled         = true
# demo_enabled        = true
# ask_monthly_cap_usd = 0.25

# If stopwatch-staging-{lake,site,artifacts} are taken in the global S3 namespace:
# bucket_suffix = "-a1b2"

# Optional custom domain (certificate must be in us-east-1):
# domain_aliases      = ["staging.stopwatch.example"]
# acm_certificate_arn = "arn:aws:acm:us-east-1:<account>:certificate/<id>"
