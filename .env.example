# Copy to .env for local development. Never commit .env.
# In AWS, secrets come from SSM Parameter Store under $SSM_PREFIX (see docs/05 §8).
STOPWATCH_ENV=local
AGENCIES=mbta
PUBLIC_BASE_URL=http://localhost:5173

# Feature flags
INGEST_ENABLED=true
ALERTS_ENABLED=false
ASK_ENABLED=false
DEMO_ENABLED=true

# Storage (compose overrides these to /data/...)
LAKE_URL=file://.localdata/lake
SITE_URL=file://.localdata/site

# Postgres (compose provides these; host-run commands use port 5433)
DATABASE_URL=postgresql://stopwatch_app:app-local-only@localhost:5433/stopwatch
DATABASE_OWNER_URL=postgresql://stopwatch_owner:owner-local-only@localhost:5433/stopwatch

# Sessions / CSRF signing (any long random string locally: python -c "import secrets;print(secrets.token_urlsafe(48))")
SESSION_SECRET=change-me-local-only-0123456789abcdefghijklmnopqrstuvwxyz

# Google sign-in (optional locally; demo accounts work without it)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web Push (optional; generate with: uv run python -m stopwatch.alerts.vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Ask Stopwatch (optional; leave empty to use the guided form fallback)
ANTHROPIC_API_KEY=
ASK_MONTHLY_CAP_USD=1.0

LOG_LEVEL=INFO
