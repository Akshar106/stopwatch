# Local development image (production runs as Lambda zip packages; see scripts/package_lambda.sh).
FROM python:3.13-slim
COPY --from=ghcr.io/astral-sh/uv:0.5 /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_LINK_MODE=copy PYTHONUNBUFFERED=1 PATH="/opt/venv/bin:$PATH"
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --all-extras --no-install-project
COPY . .
RUN uv sync --frozen --all-extras
CMD ["uvicorn", "stopwatch.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--app-dir", "src"]
